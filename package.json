{
  "name": "index-system",
  "version": "1.2.0",
  "description": "一些实用工具",
  "private": false,
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "build:umd": "tsc --noEmit -p tsconfig.node.json && vite build",
    "build:all": "npm run build && npm run build:umd",
    "test": "npm run build && node --test scripts/test.cjs",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.cjs\" \"index.ts\" \"sample.ts\" \"vite.config.mts\" \"vite.esm.config.mts\"",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.cjs\" \"*.ts\" \"*.mts\"",
    "release": "node scripts/release.cjs",
    "versionAdd": "npm version patch"
  },
  "author": "fancy-xiaolu",
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.19.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.0.0",
    "typescript": "^4.5.5",
    "vite": "^8.3.5"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist/**/*"
  ],
  "dependencies": {
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/15998194741/utils.git"
  },
  "homepage": "https://github.com/15998194741/utils",
  "bugs": {
    "url": "https://github.com/15998194741/utils/issues"
  },
  "keywords": [
    "copy",
    "xlsx",
    "regular"
  ]
}
